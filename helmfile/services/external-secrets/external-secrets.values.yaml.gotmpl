external-secrets:
  enabled: false

resources:
  enabled: true

secretStore:
  name: {{ .Environment.Values.externalSecrets.storeName | default "azure-kv" | quote }}
  namespace: {{ .Environment.Values.global.namespace | quote }}
  secretName: {{ .Environment.Values.externalSecrets.secretName | default "azure-kv-sp" | quote }}

externalSecrets:
  refreshPolicy: OnChange
  refreshInterval: "0"
  items:
    - name: ghcr-pull
      targetName: ghcr-pull
      creationPolicy: Owner
      targetTemplate:
        type: kubernetes.io/dockerconfigjson
        data:
          .dockerconfigjson: |
            {"auths":{"ghcr.io":{"username":"{{ "{{ .username }}" }}","password":"{{ "{{ .password }}" }}","email":"{{ "{{ .email }}" }}","auth":"{{ "{{ printf \"%s:%s\" .username .password | b64enc }}" }}"}}}
      data:
        - secretKey: username
          remoteKey: GHCR-USERNAME
        - secretKey: password
          remoteKey: GHCR-TOKEN
        - secretKey: email
          remoteKey: GHCR-EMAIL
    - name: pguser
      targetName: pguser
      data:
        - secretKey: pguser
          remoteKey: PGUSER
    - name: pgpass
      targetName: pgpass
      data:
        - secretKey: pgpass
          remoteKey: PGPASSWORD
    - name: lakekeeper-spark-client
      targetName: lakekeeper-spark-client
      refreshPolicy: Periodic
      refreshInterval: 1h
      data:
        - secretKey: client-id
          remoteKey: ampere-iceberg-spark-client-id
        - secretKey: client-secret
          remoteKey: ampere-iceberg-spark-client-secret
    - name: lakekeeper-dbt-client
      targetName: lakekeeper-dbt-client
      refreshPolicy: Periodic
      refreshInterval: 1h
      data:
        - secretKey: client-id
          remoteKey: ampere-iceberg-dbt-client-id
        - secretKey: client-secret
          remoteKey: ampere-iceberg-dbt-client-secret
