{{- $pgHost := .Environment.Values.postgresql.host -}}
executor: CeleryExecutor

createUserJob:
  useHelmHooks: false
  nodeSelector:
    kubernetes.io/hostname: {{ .Environment.Values.airflow.node }}

migrateDatabaseJob:
  useHelmHooks: false
  ttlSecondsAfterFinished: 0
  nodeSelector:
    kubernetes.io/hostname: {{ .Environment.Values.airflow.node }}

data:
  metadataConnection:
    user: {{ .Environment.Values.postgresql.airflowUser }}
    protocol: postgresql
    host: {{ if contains "." $pgHost }}{{ $pgHost }}{{ else }}{{ printf "%s.%s.svc.cluster.local" $pgHost .Environment.Values.global.namespace }}{{ end }}
    port: {{ .Environment.Values.postgresql.port }}
    db: {{ .Environment.Values.postgresql.airflowDatabase }}
    sslmode: disable

env:
  - name: PYTHONPATH
    value: "/opt/airflow/dags/current"
  # Iceberg image and warehouse Variables are managed in Airflow Admin > Variables.
  # Keep AIRFLOW_VAR_ICEBERG_* out of this list so UI values take effect.
  - name: AIRFLOW__PROVIDERS_ODBC__ALLOW_DRIVER_IN_EXTRA
    value: "true"
  - name: AIRFLOW__LOGGING__REMOTE_LOGGING
    value: "true"
  - name: AIRFLOW__LOGGING__REMOTE_BASE_LOG_FOLDER
    value: "s3://airflow-logs"
  - name: AIRFLOW__LOGGING__REMOTE_LOG_CONN_ID
    value: "aws_default"
  - name: AIRFLOW_CONN_AWS_DEFAULT
    value: "aws://?endpoint_url=http%3A%2F%2Fminio.ampere.svc.cluster.local%3A9000&region_name=us-east-1"

secret:
  - envName: AWS_ACCESS_KEY_ID
    secretName: minio-creds
    secretKey: MINIO_ACCESS_KEY
  - envName: AWS_SECRET_ACCESS_KEY
    secretName: minio-creds
    secretKey: MINIO_SECRET_KEY


webserverSecretKeySecretName: airflow-webserver-secret
# The Apache Airflow chart otherwise generates a new API log-auth key on
# every Helm upgrade. Keep the key in Azure Key Vault via External Secrets.
apiSecretKeySecretName: airflow-api-secret-key-stable

images:
  migrationsWaitTimeout: 600
  airflow:
    repository: {{ .Environment.Values.airflow.image.repository }}
    tag: {{ .Environment.Values.airflow.image.tag }}
    pullPolicy: {{ .Environment.Values.airflow.image.pullPolicy }}

ingress:
  apiServer:
    enabled: false

workers:
  serviceAccount:
    name: {{ .Environment.Values.airflow.workerServiceAccount | quote }}
  # Store the worker Pod IP in TaskInstance.hostname so the API server can
  # request live logs without relying on bare Pod-name DNS records.
  env:
    - name: AIRFLOW__CORE__HOSTNAME_CALLABLE
      value: airflow.utils.net.get_host_ip_address
  # Let Kubernetes choose among nodes 1–3 based on each node's allocatable
  # resources and the worker Pod's requests. KEDA controls replica count only.
  affinity:
    nodeAffinity:
      requiredDuringSchedulingIgnoredDuringExecution:
        nodeSelectorTerms:
          - matchExpressions:
              - key: kubernetes.io/hostname
                operator: In
                values:
                  - ampere-k8s-node1
                  - ampere-k8s-node2
                  - ampere-k8s-node3
    podAntiAffinity:
      preferredDuringSchedulingIgnoredDuringExecution:
        - weight: 100
          podAffinityTerm:
            labelSelector:
              matchLabels:
                component: worker
            topologyKey: kubernetes.io/hostname
  persistence:
    # Keep task logs pod-local; remote MinIO logging is the durable store.
    enabled: false
    storageClassName: {{ .Environment.Values.global.storageClass }}
  livenessProbe:
    timeoutSeconds: 60
    periodSeconds: 60
    failureThreshold: 3
    initialDelaySeconds: 30
  replicas: 2
  keda:
    enabled: true
    minReplicaCount: 2
    maxReplicaCount: 3
    pollingInterval: 30
    cooldownPeriod: 180
  resources:
    requests:
      cpu: "200m"
      memory: "768Mi"
    limits:
      cpu: "500m"
      memory: "2Gi"

config:
  core:
    dags_folder: /opt/airflow/dags/current
  dag_processor:
    refresh_interval: 60
  celery:
    worker_concurrency: 2
  logging:
    log_server_host: "airflow-worker"
    log_server_port: 8793
    log_server_ssl: false
  database:
    sql_alchemy_pool_size: 10
    sql_alchemy_max_overflow: 30
    sql_alchemy_pool_recycle: 1800
    sql_alchemy_pool_pre_ping: true

triggerer:
  nodeSelector:
    kubernetes.io/hostname: {{ .Environment.Values.airflow.node }}
  persistence:
    # Triggerer logs are pod-local and uploaded to MinIO.
    # Disable its StatefulSet PVC template along with the shared log PVC.
    enabled: false
    storageClassName: {{ .Environment.Values.global.storageClass }}
  replicas: 1
  resources:
    requests:
      cpu: "200m"
      memory: "768Mi"
    limits:
      cpu: "500m"
      memory: "1Gi"
  livenessProbe:
    timeoutSeconds: 60
    periodSeconds: 60
    failureThreshold: 3
    initialDelaySeconds: 20

redis:
  nodeSelector:
    kubernetes.io/hostname: {{ .Environment.Values.airflow.node }}
  containerLifecycleHooks:
    preStop:
      exec:
        command:
          - sh
          - -c
          - 'redis-cli -a "$REDIS_PASSWORD" shutdown save || true'
  persistence:
    # Preserve the existing StatefulSet claim template; changing this field
    # requires replacing airflow-redis and its persistent claim.
    storageClassName: local-path

dags:
  persistence:
    enabled: true
    existingClaim: airflow-dags-source
    storageClassName: {{ .Environment.Values.ivyCacheNfs.storageClass }}
    accessMode: ReadWriteMany
  gitSync:
    enabled: false

logs:
  persistence:
    # Avoid the local-path RWX claim; MinIO is the durable task-log store.
    enabled: false

postgresql:
  enabled: false

webserver:
  enabled: false

apiServer:
  nodeSelector:
    kubernetes.io/hostname: {{ .Environment.Values.airflow.node }}
  # The API server is a single replica pinned to one node. Recreate avoids a
  # second surge pod that cannot fit on that node during Helm upgrades.
  strategy:
    type: Recreate

  waitForMigrations:
    enabled: false

  startupProbe:
    initialDelaySeconds: 20
    periodSeconds: 10
    timeoutSeconds: 5
    failureThreshold: 30
    scheme: HTTP

  readinessProbe:
    initialDelaySeconds: 15
    periodSeconds: 10
    timeoutSeconds: 5
    failureThreshold: 10
    scheme: HTTP

  livenessProbe:
    initialDelaySeconds: 15
    periodSeconds: 10
    timeoutSeconds: 5
    failureThreshold: 10
    scheme: HTTP

  resources:
    requests:
      cpu: "300m"
      memory: "768Mi"
    limits:
      cpu: "500m"
      memory: "1560Mi"
  service:
    type: ClusterIP
    ports:
      - name: api-server
        port: 8080
        targetPort: api-server
  env:
    - name: AIRFLOW__API__BASE_URL
      value: {{ .Environment.Values.airflow.host }}
    - name: AIRFLOW__API__WORKERS
      value: "1"

scheduler:
  nodeSelector:
    kubernetes.io/hostname: {{ .Environment.Values.airflow.node }}
  strategy:
    type: Recreate
  livenessProbe:
    timeoutSeconds: 90
    periodSeconds: 60
    failureThreshold: 5
  replicas: 1
  resources:
    requests:
      cpu: "300m"
      memory: "768Mi"
    limits:
      cpu: "600m"
      memory: "1Gi"

dagProcessor:
  nodeSelector:
    kubernetes.io/hostname: {{ .Environment.Values.airflow.node }}
  replicas: 1
  resources:
    requests:
      cpu: "400m"
      memory: "1280Mi"
    limits:
      cpu: "1"
      memory: "2Gi"
  livenessProbe:
    timeoutSeconds: 60
    periodSeconds: 60
    failureThreshold: 5
    initialDelaySeconds: 30

statsd:
  nodeSelector:
    kubernetes.io/hostname: {{ .Environment.Values.airflow.node }}
