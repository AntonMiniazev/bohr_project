{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GoldBucketRead",
      "Effect": "Allow",
      "Action": ["s3:GetBucketLocation", "s3:ListBucket"],
      "Resource": "arn:aws:s3:::ampere-iceberg-gold"
    },
    {
      "Sid": "GoldObjectsRead",
      "Effect": "Allow",
      "Action": ["s3:GetObject"],
      "Resource": "arn:aws:s3:::ampere-iceberg-gold/*"
    }
  ]
}
